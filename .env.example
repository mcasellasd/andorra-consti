# Generació de text (obligatòria per chatbot i interpretació IA)
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b

# Proveïdor LLM: groq (per defecte) o groq-local. salamandra = àlies de groq (compatibilitat)
# LLM_PROVIDER=groq

# Upstash Vector híbrid (índex BGE-M3 + BM25, regió UE)
RAG_BACKEND=upstash
UPSTASH_VECTOR_REST_URL=https://YOUR_VECTOR_ENDPOINT
UPSTASH_VECTOR_REST_TOKEN=YOUR_VECTOR_TOKEN
UPSTASH_VECTOR_NAMESPACE=corpus-v1

# Upstash Redis (regió UE)
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS_ENDPOINT
UPSTASH_REDIS_REST_TOKEN=YOUR_REDIS_TOKEN

# Administració
ADMIN_API_TOKEN=GENERATE_A_LONG_RANDOM_TOKEN
ADMIN_SESSION_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
SESSION_QUOTA_SECRET=GENERATE_A_LONG_RANDOM_SESSION_QUOTA_SECRET
